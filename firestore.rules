rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User A cannot read/overwrite user B
    match /mediaItems/{mediaId} {
      // create must set ownerId == auth.uid, and id == mediaId
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.id == mediaId
                    && request.resource.data.keys().hasAll(['id','ownerId','kind','fileName','mimeType','size','storagePath','downloadUrl','createdAt','status'])
                    && request.resource.data.storagePath.matches('uploads/' + request.auth.uid + '/[0-9]{4}/.+')
                    && request.resource.data.kind in ['image','video','document']
                    && request.resource.data.status in ['queued','uploading','paused','done','failed'];
      // read/update/delete only owner
      allow read, update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      // on update, ownerId and id are immutable
      allow update: if request.auth != null
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.id == resource.data.id;
    }
    // deny everything else by default (no open collection)
    match /{document=**} { allow read, write: if false; }
  }
}
