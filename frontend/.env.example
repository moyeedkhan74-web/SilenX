# ─────────────────────────────────────────────────────────────────────────────
# SlienX Frontend — Environment Variables
# Copy this file to .env.local and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API URL (must be https:// in production)
# Example: VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=

# Socket.IO server URL (must be https:// in production, picks up ws:// automatically)
# Example: VITE_SOCKET_URL=https://your-backend.onrender.com
VITE_SOCKET_URL=

# ─── Calls (LiveKit) ──────────────────────────────────────────────────────────
# No frontend TURN/STUN config is needed anymore. Calls run through LiveKit
# Cloud (global SFU + built-in TURN), and the LiveKit URL + access token are
# issued by the backend at POST /api/group-calls/livekit/token.
# Configure LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET on the BACKEND.

# ─── GIPHY Integration ────────────────────────────────────────────────────────
VITE_GIPHY_API_KEY=FJc0d6OAjgypqFa3I1rCIQuiGieP8qVs

