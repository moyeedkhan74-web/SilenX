# ─────────────────────────────────────────────────────────────────────────────
# SlienX Frontend — Environment Variables
# Copy this file to .env.local and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API URL (must be https:// in production)
# Example: VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=

# Socket.IO server URL (must be https:// in production, picks up ws:// automatically)
# Example: VITE_SOCKET_URL=https://your-backend.onrender.com
VITE_SOCKET_URL=

# ─── TURN Server (required for mobile / cross-network calls) ──────────────────
# Get free credentials at: https://www.metered.ca/tools/openrelay/
# Format for VITE_TURN_URL: turn:openrelay.metered.ca:80  (no https://)

VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_PASSWORD=

# ─── GIPHY Integration ────────────────────────────────────────────────────────
VITE_GIPHY_API_KEY=FJc0d6OAjgypqFa3I1rCIQuiGieP8qVs

