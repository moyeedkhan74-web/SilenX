{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Permissions-Policy", "value": "camera=(self),microphone=(self)" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "headers": [
        { "key": "Vary", "value": "Accept, Accept-Encoding" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/.well-known/mcp", "destination": "/api/mcp" },
    { "source": "/", "destination": "/api/negotiate?page=/" },
    { "source": "/login", "destination": "/api/negotiate?page=/login" },
    { "source": "/chats", "destination": "/api/negotiate?page=/chats" },
    { "source": "/contacts", "destination": "/api/negotiate?page=/contacts" },
    { "source": "/calls", "destination": "/api/negotiate?page=/calls" },
    { "source": "/profile", "destination": "/api/negotiate?page=/profile" },
    { "source": "/settings", "destination": "/api/negotiate?page=/settings" },
    { "source": "/about", "destination": "/api/negotiate?page=/about" },
    { "source": "/contact", "destination": "/api/negotiate?page=/contact" },
    { "source": "/privacy", "destination": "/api/negotiate?page=/privacy" }
  ]
}
