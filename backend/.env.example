PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://your_mongo_url
JWT_SECRET=your_jwt_secret

# Frontend / CORS
FRONTEND_URL=https://silen-x.vercel.app

# LiveKit (group + 1-on-1 calls)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ImageKit CDN (primary media delivery)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Backblaze B2 / S3 fallback storage
B2_ENDPOINT=
B2_REGION=us-east-1
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=silenx-media-uploads

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Web Push (VAPID) - browser notifications while the tab is hidden or closed.
# Generate once with: npx web-push generate-vapid-keys
# Copy the same VAPID_PUBLIC_KEY into frontend/.env as VITE_WEB_PUSH_VAPID_PUBLIC_KEY
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact string for push services (mailto: or https: URL)
VAPID_SUBJECT=mailto:notifications@slienx.app
