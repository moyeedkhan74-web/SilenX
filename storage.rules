// storage.rules
// Firebase Storage Rules for SilenX
// Only signed-in users can upload files under their own user folder.
// Enforces size and content-type limits based on MediaConfig.

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Match any file under the uploads directory
    match /uploads/{userId}/{allPaths=**} {
      // Allow only if the user is authenticated and the userId matches the auth token
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Validate file size and content type on upload
      // Note: These rules are applied to the final object (after upload)
      // We can't validate chunked uploads, but we can validate the final size.
      // For simplicity, we validate on write.
      // We break down by file type based on extension in the path.
      // However, it's easier to validate by the content type and size directly.

      // Max sizes (in bytes)
      let maxImageSize = 10 * 1024 * 1024; // 10 MB
      let maxVideoSize = 100 * 1024 * 1024; // 100 MB
      let maxDocSize = 50 * 1024 * 1024; // 50 MB

      // Allowed MIME types
      let allowedImageMimes = ['image/jpeg', 'image/png', 'image/webp', 'image/heic'];
      let allowedVideoMimes = ['video/mp4', 'video/quicktime', 'video/webm'];
      let allowedDocMimes = [
        'application/pdf',
        'application/msword',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
        'application/vnd.ms-excel',
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
        'application/vnd.ms-powerpoint',
        'application/vnd.openxmlformats-officedocument.presentationml.presentation',
        'text/plain',
        'application/zip',
      ];

      // Determine if the file is an image, video, or document based on content type
      let isImage = request.resource.contentType in allowedImageMimes;
      let isVideo = request.resource.contentType in allowedVideoMimes;
      let isDoc = request.resource.contentType in allowedDocMimes;

      // Allow write only if the content type is allowed and the size is within limits
      allow write: if (
        request.auth != null &&
        request.auth.uid == userId &&
        (
          (isImage && request.resource.size <= maxImageSize) ||
          (isVideo && request.resource.size <= maxVideoSize) ||
          (isDoc && request.resource.size <= maxDocSize)
        )
      );

      // Allow read only if the user is the owner (or we could allow read for shared files later)
      allow read: if request.auth != null && request.auth.uid == userId;
    }
  }
}